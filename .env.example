# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Las variables marcadas como obligatorias no tienen valor por defecto: la API no arranca si faltan.

# ---- Entorno
APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# ---- Base de datos (obligatoria). Formato: postgresql+psycopg://USUARIO:CLAVE@HOST:5432/BASE
# En Docker Compose la API la construye sola; esta sirve para la CLI desde el host
# (postgresql+psycopg://nlp_tickets:<POSTGRES_PASSWORD>@127.0.0.1:55432/nlp_tickets) o para Neon.
DATABASE_URL=
POSTGRES_USER=nlp_tickets
POSTGRES_PASSWORD=
POSTGRES_DB=nlp_tickets

# ---- Autenticación por API key (obligatorias). Lista separada por comas, cada clave >= 32 caracteres.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS_CLIENT=
API_KEYS_REVIEWER=

# ---- Seguridad HTTP
CORS_ALLOWED_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=60

# ---- Modelo
MODEL_DIR=artifacts/model
# Descarga opcional del paquete del modelo (GitHub Releases) y su hash SHA-256 para verificarlo
MODEL_URL=
MODEL_SHA256=
CONFIDENCE_THRESHOLD_OVERRIDE=

# ---- Entrenamiento
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ---- Puertos locales de Docker Compose (solo 127.0.0.1)
API_PORT=8000
DEMO_PORT=8501

# ---- Demo Streamlit
API_BASE_URL=http://localhost:8000
DEMO_API_KEY=
DEMO_REVIEWER_KEY=
# Cuentas de la demo: solo el hash Argon2id, entre comillas simples (contiene "$").
# Genera cada hash con: uv run --with argon2-cffi python demo/hash_password.py
DEMO_USER=demo
DEMO_PASSWORD_HASH=
REVIEWER_USER=revisor
REVIEWER_PASSWORD_HASH=
